[sub_resource type="Resource" id="skill_effect"]
script = ExtResource("silence")
ticks = 140

[sub_resource type="Resource" id="skill"]
script = ExtResource("skill")
display_name = "Три головы"
description = "В волну: башни на полях, куда идёт ваша армия, 7 секунд не стреляют."
