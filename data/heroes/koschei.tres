[gd_resource type="Resource" script_class="HeroData" load_steps=5 format=3]
[ext_resource type="Script" path="res://src/sim/heroes/hero_data.gd" id="hero"]
[ext_resource type="Script" path="res://src/sim/heroes/hero_effect.gd" id="effect"]
[ext_resource type="Script" path="res://src/sim/heroes/effects/koschei_chest_effect.gd" id="koschei"]

[ext_resource type="Resource" path="res://data/towers/hex.tres" id="affinity_gift"]

[sub_resource type="Resource" id="passive_0"]
script = ExtResource("koschei")
threshold_percent = 50

[resource]
script = ExtResource("hero")
id = &"koschei"
display_name = "Кощей Бессмертный"
epithet = "Смерть его — в игле, игла — в сундуке"
description = "HP всего 34. Когда HP впервые падает ниже половины — самая дорогая башня рушится, а все остальные +1 уровень."
style = "риск, камбек"
hp = 34
passives = Array[ExtResource("effect")]([SubResource("passive_0")])

affinity_god = &"curse"
affinity_gift = ExtResource("affinity_gift")
