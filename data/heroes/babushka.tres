[gd_resource type="Resource" script_class="HeroData" load_steps=9 format=3]
[ext_resource type="Script" path="res://src/sim/heroes/hero_data.gd" id="hero"]
[ext_resource type="Script" path="res://src/sim/heroes/hero_effect.gd" id="effect"]
[ext_resource type="Script" path="res://src/sim/heroes/effects/stat_hero_effect.gd" id="stat"]
[ext_resource type="Script" path="res://src/sim/heroes/effects/heal_hero_effect.gd" id="heal"]
[ext_resource type="Script" path="res://src/sim/heroes/hero_skill_data.gd" id="skill"]

[ext_resource type="Resource" path="res://data/towers/dew.tres" id="affinity_gift"]

[sub_resource type="Resource" id="passive_0"]
script = ExtResource("stat")
kind = 5
value = 25

[sub_resource type="Resource" id="skill_effect"]
script = ExtResource("heal")
amount = 4

[sub_resource type="Resource" id="skill"]
script = ExtResource("skill")
display_name = "Пирожки"
description = "+4 HP терему (не выше стартового)."
timing = 0
cost = 4
cost_step = 2
effect = SubResource("skill_effect")

[resource]
script = ExtResource("hero")
id = &"babushka"
display_name = "Бабушка у подъезда"
epithet = "Всё видит с лавочки, всех накормит"
description = "Чужие армии на вашем поле на 25% медленнее."
style = "оборона, лечение"
hp = 40
passives = Array[ExtResource("effect")]([SubResource("passive_0")])
skill = SubResource("skill")

affinity_god = &"water"
affinity_gift = ExtResource("affinity_gift")
