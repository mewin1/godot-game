class_name RitualAlley
extends Resource
## Проулок-срезка (docs/37 ALY-1, решение D6): короткий путь в обход части дороги lane.
## Быстрые враги идут им всегда, когда он открыт; остальные — только если впереди на дороге
## частокол или смола. Игрок может завалить проулок баррикадой за золото и разобрать её.

## Дорога, от которой отходит проулок (индекс маршрута поля: 0 — главная).
@export var lane: int = 0
## Клетки проулка по порядку: первая — у дороги перед срезаемым отрезком, последняя — после него.
@export var cells: Array[Vector2i] = []
## С какого уровня города проулок открыт.
@export var city_level: int = 2
@export var barricade_cost: int = 15
## Враг со скоростью не ниже этой (тысячные клетки за тик) считается быстрым.
@export var fast_speed_milli: int = 70
