class_name RitualStreetData
extends Resource
## Пристраиваемая улица «Городища» (docs/34 §3): новый квартал со своим входом для нежити.
## Места под дома открываются сразу после покупки, вход — со следующей ночи.

@export var title: String = ""
## Маршрут врагов от нового входа до сторожки Ильи (последняя клетка — та же, что у главной дороги).
@export var path_cells: Array[Vector2i] = []
## Места под дома в новом квартале.
@export var build_regions: Array[Rect2i] = []
## Проулок через стартовые дома от главной дороги к дороге улицы (клетки между ними, по порядку
## от главной). Щель заложена в платформе с самого начала — строить в ней нельзя; с пристройкой
## улицы проулок открывается и часть пачки сворачивает в него.
@export var alley_cells: Array[Vector2i] = []
@export var cost: int = 0
## Подать (docs/36 §3): золото каждый рассвет после ночи, в которую вход улицы уже был открыт.
@export var tribute: int = 0
